# Environment variables for ShikkhaDwar LMS
# Copy this file to .env and update with your actual values

# Flask Configuration
SECRET_KEY=your-super-secret-key-here-change-this-in-production
FLASK_ENV=production

# Database Configuration
# For NeonDB: Use the DATABASE_URL provided by NeonDB
# Format: postgresql://[user]:[password]@[host]/[database]?sslmode=require
DATABASE_URL=postgresql://user:password@host.neon.tech/lms_db?sslmode=require

# Legacy individual DB fields (optional if DATABASE_URL is set)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=lms_db

# Upload Configuration
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216

# Production Settings
# Set to 'production' when deploying to Render
PYTHON_VERSION=3.11.0

# Security Note:
# - Never commit .env to version control
# - Use strong, unique passwords in production
# - Generate a strong SECRET_KEY for production
# - Get DATABASE_URL from NeonDB dashboard